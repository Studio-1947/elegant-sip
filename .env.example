# Root overrides for docker-compose. Copy to `.env` (gitignored) and fill in.
#
# Everything here has a working default in docker-compose.yml, so this file is
# only needed when you want to change something — notably, sending real email.
#
# ── Real email ───────────────────────────────────────────────────────────────
# By default all mail goes to Mailpit (http://localhost:8025) and cannot reach a
# real inbox. That is deliberate: development must not be able to email a
# customer. Set SMTP_URL to send for real.
#
# Gmail — fine for testing, ~500 sends/day. Requires 2-Step Verification on the
# Google account, then an App Password (16 characters, NOT your login password):
#   https://myaccount.google.com/apppasswords
# Gmail rewrites the From header to the authenticated account, so MAIL_FROM must
# be that same address or messages will look wrong.
#
#   SMTP_URL=smtp://you%40gmail.com:abcdefghijklmnop@smtp.gmail.com:587
#   MAIL_FROM=Elegant Sip <you@gmail.com>
#
# NOTE: the address and password are URL-encoded inside the connection string —
# `@` becomes %40, and any of : / ? # [ ] @ in the password must be encoded too.
#
# Resend — the production choice. Verify elegantsip.in and add the SPF/DKIM
# records they give you, then:
#
#   SMTP_URL=smtp://resend:re_yourapikey@smtp.resend.com:587
#   MAIL_FROM=Elegant Sip <orders@elegantsip.in>
#
SMTP_URL=
MAIL_FROM=

# Where the site actually runs. Email links are built from this, so a wrong
# value produces links that resolve to nothing.
#   dev server: http://localhost:5173
#   built site: http://localhost:4500
#   production: https://elegantsip.in
SITE_URL=

# Origins allowed to call the API. The deployed storefront must be listed or
# the browser blocks every request.
CORS_ORIGINS=

# ── Payments (phase 03) ──────────────────────────────────────────────────────
# PAYMENT_PROVIDER=razorpay requires all three. The API refuses to start without
# them rather than silently falling back to the fake gateway.
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── GST ──────────────────────────────────────────────────────────────────────
# Without a GSTIN, invoices are generated but labelled provisional — a document
# cannot claim to be a tax invoice without one.
SELLER_GSTIN=
SELLER_STATE=West Bengal
