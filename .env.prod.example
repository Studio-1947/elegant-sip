# Elegant Sip — production settings for the server.
#
#   cp .env.prod.example .env
#   nano .env
#
# `.env` is gitignored and must stay that way: it holds real passwords. Nothing
# in here belongs in a commit, a screenshot, or a chat message.

# ── Database ─────────────────────────────────────────────────────────────────
# Invent a long random password. It is never typed by a human — the containers
# read it from this file — so make it unwieldy. To generate one on the server:
#
#   openssl rand -hex 30
#
# Use hexadecimal rather than Base64: this password is embedded in DATABASE_URL
# inside Compose, and hex contains no URL-reserved characters.
#
POSTGRES_USER=elegantsip
POSTGRES_PASSWORD=
POSTGRES_DB=elegantsip

# Time zone for the nightly 02:30 database backup.
BACKUP_TIMEZONE=Asia/Kolkata

# ── Where the site lives ─────────────────────────────────────────────────────
# Before a domain: use the server's IP, over http, with no trailing slash.
#
#   SITE_ADDRESS=
#   SITE_URL=http://203.0.113.10
#
# After pointing a domain at this server: name it in SITE_ADDRESS and Caddy
# obtains an HTTPS certificate on the next restart — nothing else to install.
#
#   SITE_ADDRESS=elegantsip.in
#   SITE_URL=https://elegantsip.in
#
# Keep the two consistent. SITE_URL decides the links inside emails and whether
# sign-in cookies are marked Secure, so an `https` here without HTTPS actually
# working would stop anyone signing in.
SITE_ADDRESS=elegantsip.in
SITE_URL=https://elegantsip.in

# ── Sharing the server with other projects ───────────────────────────────────
# If this VPS already runs a reverse proxy (nginx, Traefik) for other sites, it
# owns 80 and 443 and this stack must sit behind it instead of beside it:
#
#   SITE_ADDRESS=                      ← empty: Caddy serves plain HTTP only
#   SITE_URL=https://elegantsip.in     ← still https: the proxy terminates TLS
#   WEB_PUBLISH_HTTP=127.0.0.1:8080    ← reachable from the proxy, not the world
#   WEB_PUBLISH_HTTPS=127.0.0.1:8443   ← unused, but must not collide with 443
#
# This is the one case where SITE_ADDRESS and SITE_URL deliberately disagree.
# SITE_URL describes what the browser sees, which is HTTPS, so cookies are
# still marked Secure; SITE_ADDRESS describes what Caddy itself serves, which
# is HTTP, so it does not try to obtain a certificate it has no way to validate.
# Then point the proxy at http://127.0.0.1:8080 and let it handle the domain.

# ── Email ────────────────────────────────────────────────────────────────────
# Leave blank and no mail is sent. The site is built for that: it never claims
# an email went out that did not, and shows codes on screen instead.
#
# Gmail needs 2-Step Verification, then an App Password (16 characters, not
# your login password): https://myaccount.google.com/apppasswords
# The address and password are URL-encoded in the string — `@` becomes %40.
#
#   SMTP_URL=smtp://you%40gmail.com:apppasswordhere@smtp.gmail.com:587
#   MAIL_FROM=Elegant Sip <you@gmail.com>
#
SMTP_URL=
MAIL_FROM=

# ── Payments ─────────────────────────────────────────────────────────────────
# Production must use Razorpay. The API refuses to start with the fake gateway,
# blank payment credentials, or no SMTP transport.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Swagger is off publicly by default. Enable only temporarily from a trusted network.
API_DOCS_ENABLED=false

# ── GST ──────────────────────────────────────────────────────────────────────
# Without a GSTIN invoices still generate, but are marked provisional — a
# document cannot call itself a tax invoice without one.
SELLER_GSTIN=
SELLER_STATE=West Bengal

LOG_LEVEL=info
