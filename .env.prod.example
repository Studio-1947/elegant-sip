# Elegant Sip — production settings for the server.
#
#   cp .env.prod.example .env
#   nano .env
#
# `.env` is gitignored and must stay that way: it holds real passwords. Nothing
# in here belongs in a commit, a screenshot, or a chat message.

# ── Database ─────────────────────────────────────────────────────────────────
# Invent a long random password. It is never typed by a human — the containers
# read it from this file — so make it unwieldy. To generate one on the server:
#
#   openssl rand -hex 30
#
# Use hexadecimal rather than Base64: this password is embedded in DATABASE_URL
# inside Compose, and hex contains no URL-reserved characters.
#
POSTGRES_USER=elegantsip
POSTGRES_PASSWORD=
POSTGRES_DB=elegantsip

# Time zone for the nightly 02:30 database backup.
BACKUP_TIMEZONE=Asia/Kolkata

# ── Off-site backup copies ───────────────────────────────────────────────────
# The nightly dumps live on this server, so a lost or wiped server takes them
# with it. Fill these in and the `offsite` service copies every dump, encrypted,
# to S3-compatible storage at start and nightly at 03:15. Left blank, nothing
# leaves the server and the API logs a warning at start.
#
# Any S3-compatible bucket works. Make it PRIVATE and give the key access to
# that bucket only.
#   Cloudflare R2 (10 GB free):  OFFSITE_S3_PROVIDER=Cloudflare
#                                OFFSITE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#                                OFFSITE_S3_REGION=auto
#   Backblaze B2:                OFFSITE_S3_PROVIDER=Other
#                                OFFSITE_S3_ENDPOINT=https://s3.<region>.backblazeb2.com
#   AWS S3 (Mumbai):             OFFSITE_S3_PROVIDER=AWS
#                                OFFSITE_S3_ENDPOINT=   (blank)
#                                OFFSITE_S3_REGION=ap-south-1
#
# OFFSITE_S3_BUCKET is the bucket name, optionally with a folder:
# `elegantsip-backups/prod`.
#
# OFFSITE_ENCRYPT_PASSWORD encrypts the dumps before they leave the server; they
# hold customer names, addresses and phone numbers, so nothing is uploaded
# without it. Generate one with `openssl rand -hex 32` and ALSO store it
# somewhere other than this server (a password manager): without it the
# off-site copies cannot be decrypted, and losing the server loses this file.
# Never change it once set, or older copies need the old one.
OFFSITE_S3_BUCKET=
OFFSITE_S3_PROVIDER=Cloudflare
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_REGION=auto
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
OFFSITE_ENCRYPT_PASSWORD=
# Copies older than this are deleted from the bucket (only while new ones arrive).
OFFSITE_KEEP_DAYS=90

# ── Server alerts ────────────────────────────────────────────────────────────
# The API checks every WATCHDOG_MINUTES and emails CONTACT_INBOX (below) when
# free disk drops under DISK_ALERT_PERCENT, or a backup or off-site copy fails
# or stops. Needs SMTP_URL to send. 0 turns the checks off. Whole-site outages
# are caught from outside by .github/workflows/uptime.yml instead.
WATCHDOG_MINUTES=30
DISK_ALERT_PERCENT=15

# ── Where the site lives ─────────────────────────────────────────────────────
# Before a domain: use the server's IP, over http, with no trailing slash.
#
#   SITE_ADDRESS=
#   SITE_URL=http://203.0.113.10
#
# After pointing a domain at this server: name it in SITE_ADDRESS and Caddy
# obtains an HTTPS certificate on the next restart — nothing else to install.
#
#   SITE_ADDRESS=elegantsip.in
#   SITE_URL=https://elegantsip.in
#
# Keep the two consistent. SITE_URL decides the links inside emails and whether
# sign-in cookies are marked Secure, so an `https` here without HTTPS actually
# working would stop anyone signing in.
SITE_ADDRESS=elegantsip.in
SITE_URL=https://elegantsip.in

# ── Sharing the server with other projects ───────────────────────────────────
# If this VPS already runs a reverse proxy (nginx, Traefik) for other sites, it
# owns 80 and 443 and this stack must sit behind it instead of beside it:
#
#   SITE_ADDRESS=                      ← empty: Caddy serves plain HTTP only
#   SITE_URL=https://elegantsip.in     ← still https: the proxy terminates TLS
#   WEB_PUBLISH_HTTP=127.0.0.1:8080    ← reachable from the proxy, not the world
#   WEB_PUBLISH_HTTPS=127.0.0.1:8443   ← unused, but must not collide with 443
#
# This is the one case where SITE_ADDRESS and SITE_URL deliberately disagree.
# SITE_URL describes what the browser sees, which is HTTPS, so cookies are
# still marked Secure; SITE_ADDRESS describes what Caddy itself serves, which
# is HTTP, so it does not try to obtain a certificate it has no way to validate.
# Then point the proxy at http://127.0.0.1:8080 and let it handle the domain.

# ── Whose X-Forwarded-For Caddy believes ─────────────────────────────────────
# The API rate-limits per visitor IP, and learns that IP from Caddy. Caddy must
# trust X-Forwarded-For only from a proxy that really sits in front of it,
# otherwise a visitor can send their own header and dodge the limits.
#
#   Behind the server's nginx (the WEB_PUBLISH_HTTP=127.0.0.1:8080 setup above):
#     requests reach Caddy from the Docker bridge gateway, so trust that range.
#       CADDY_TRUSTED_PROXIES=172.16.0.0/12
#     Check the network really is inside it (prints e.g. 172.18.0.0/16):
#       docker network inspect elegantsip-prod_default -f '{{(index .IPAM.Config 0).Subnet}}'
#     nginx must also send: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#
#   Caddy directly on the internet (default ports 80/443, SITE_ADDRESS=domain):
#     trust nobody. The line must be present and EMPTY:
#       CADDY_TRUSTED_PROXIES=
#
# Left out entirely, it keeps the old default `private_ranges` (every private
# address, which includes the Docker gateway). Accepted values: empty, a
# space-separated list of CIDRs/IPs, or `private_ranges`. Anything else, the
# word `none` included, stops Caddy from starting.
# CADDY_TRUSTED_PROXIES=

# ── Email ────────────────────────────────────────────────────────────────────
# Leave blank and no mail is sent. The site is built for that: it never claims
# an email went out that did not, and shows codes on screen instead.
#
# Gmail needs 2-Step Verification, then an App Password (16 characters, not
# your login password): https://myaccount.google.com/apppasswords
# The address and password are URL-encoded in the string — `@` becomes %40.
#
#   SMTP_URL=smtp://you%40gmail.com:apppasswordhere@smtp.gmail.com:587
#   MAIL_FROM=Elegant Sip <you@gmail.com>
#
SMTP_URL=
MAIL_FROM=
# Where contact-form messages, staff alerts (returned parcels, courier
# problems, refunds to make) and server alerts go. Blank keeps the default inbox.
CONTACT_INBOX=

# ── Payments ─────────────────────────────────────────────────────────────────
# Keep `disabled` until live Razorpay credentials are ready. The shop stays
# browseable but server-side checkout is blocked: no orders or stock holds.
PAYMENT_PROVIDER=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Shared Interakt delivery-status dispatcher ---
# Interakt sends all account webhooks to Elegant Sip. Forward only callbacks beginning with
# `aangan:otp:` to Aangan, preserving the original raw body and Interakt-Signature header.
# The Aangan deployment must use the SAME INTERAKT_WEBHOOK_SECRET configured in Interakt.
AANGAN_INTERAKT_WEBHOOK_URL=https://aanganerp.in/api/webhooks/interakt

# Swagger is off publicly by default. Enable only temporarily from a trusted network.
API_DOCS_ENABLED=false

# Cancel abandoned orders and return their reserved stock after this many minutes.
PENDING_PAYMENT_TTL_MINUTES=30
ORDER_EXPIRY_SWEEP_SECONDS=60

# ── WhatsApp OTP (Interakt) ─────────────────────────────────────────────────
# Leave disabled until the Authentication template is approved. Put the
# regenerated API key only in the deployed .env, never in Git or chat.
AUTH_OTP_PROVIDER=disabled
INTERAKT_API_KEY=
INTERAKT_API_BASE_URL=https://api.interakt.ai/v1/public
INTERAKT_OTP_TEMPLATE=elegant_sip_otp
INTERAKT_OTP_TEMPLATE_LANGUAGE=en
INTERAKT_WEBHOOK_SECRET=

# ── Two-step sign-in (staff) ─────────────────────────────────────────────────
# Encrypts the authenticator-app secrets of staff who turn on two-step sign-in.
# Generate once with: openssl rand -hex 32   (64 hex characters)
# Keep a copy in the shop's password manager: if it is lost or changed, staff
# can only get in with their recovery codes. Blank = two-step sign-in cannot be
# turned on.
MFA_ENCRYPTION_KEY=

# ── Staff (admin) account ────────────────────────────────────────────────────
# Created on boot as a verified admin. While both are set, this .env wins: the
# account is kept admin and its password reset to ADMIN_PASSWORD (signing it out
# everywhere) whenever they differ. Sign-in is by email. Password: 10+
# characters, from a password manager. Blank both to manage the account from the
# site instead; blanking never demotes it. A bad value is logged and skipped.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Shop admin

# ── GST ──────────────────────────────────────────────────────────────────────
# Without a GSTIN invoices still generate, but are marked provisional — a
# document cannot call itself a tax invoice without one.
SELLER_GSTIN=
SELLER_STATE=West Bengal

# ── Shipping (Shiprocket) ────────────────────────────────────────────────────
# manual | shiprocket. Shiprocket needs an API user (Settings → API → Create API
# User — a separate email from your dashboard login) and a saved pickup address.
# SHIPROCKET_PICKUP_LOCATION is that address's nickname exactly as in Shiprocket.
# Webhook: Settings → API → Webhooks, URL https://elegantsip.in/api/v1/webhooks/courier
# with SHIPROCKET_WEBHOOK_TOKEN (generate: openssl rand -hex 24) as the token.
SHIPPING_PROVIDER=manual
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_POSTCODE=
SHIPROCKET_WEBHOOK_TOKEN=
# Re-check tracking for shipments silent this many minutes (missed webhooks). 0 = off.
SHIPMENT_SYNC_MINUTES=180
# The boxed parcel, used for courier rates. Blank keeps the defaults shown.
# SHIP_PACKAGE_LENGTH_CM=20
# SHIP_PACKAGE_BREADTH_CM=15
# SHIP_PACKAGE_HEIGHT_CM=10
# SHIP_PACKAGING_WEIGHT_GRAMS=150

# ── Meta Conversions API ─────────────────────────────────────────────────────
# The server also sends the Meta Pixel's events (same event IDs, so Meta counts
# each once), which keeps ad results measurable when a browser blocks the pixel.
# Only for visitors who accepted cookies; never names, emails, phones or
# addresses. Blank token = off.
#
# Token: Events Manager → your pixel → Settings → Conversions API → Generate
# access token. Paste it here on the server only, never in Git or chat.
# To check it works, copy the code from Events Manager → Test events into
# META_CAPI_TEST_EVENT_CODE, watch events arrive, then blank it again (test
# events never count towards ads).
META_PIXEL_ID=1702510334659568
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

LOG_LEVEL=info
