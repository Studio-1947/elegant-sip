# Elegant Sip API — copy to .env for local development.
# Every variable is validated by Zod at boot; the process exits on bad config.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Matches docker-compose. Use the managed connection string in production.
DATABASE_URL=postgres://elegantsip:elegantsip@localhost:5432/elegantsip

# Origins allowed to call the API with credentials (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:4500
SITE_URL=http://localhost:5173

# ── Payments (phase 03) ──────────────────────────────────────────────────────
# Leave blank until you have Razorpay credentials. Payment routes refuse to
# operate without all three rather than half-working.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local Swagger UI is enabled unless explicitly false. Production Compose sets false.
API_DOCS_ENABLED=true

# Automatic cancellation of abandoned checkouts and stock release.
PENDING_PAYMENT_TTL_MINUTES=30
ORDER_EXPIRY_SWEEP_SECONDS=60
