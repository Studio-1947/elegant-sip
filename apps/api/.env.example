# Elegant Sip API — copy to .env for local development.
# Every variable is validated by Zod at boot; the process exits on bad config.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Matches docker-compose. Use the managed connection string in production.
DATABASE_URL=postgres://elegantsip:elegantsip@localhost:5432/elegantsip

# Origins allowed to call the API with credentials (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:4500
SITE_URL=http://localhost:5173

# ── Payments (phase 03) ──────────────────────────────────────────────────────
# fake (default in development) | razorpay | disabled. razorpay needs all three
# values below; the API refuses to start without them rather than half-working.
# The webhook secret must match the one set on the webhook in the Razorpay dashboard.
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Shipping ─────────────────────────────────────────────────────────────────
# manual (default) | fake (local courier simulation) | shiprocket.
# shiprocket requires the API user's email/password, pickup nickname and pincode.
SHIPPING_PROVIDER=manual
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_POSTCODE=
SHIPROCKET_WEBHOOK_TOKEN=

# Optional shared-Interakt dispatcher target. Configure only when the same Interakt account
# serves Aangan as well; the exact URL is public but the webhook secret remains deployment-only.
AANGAN_INTERAKT_WEBHOOK_URL=https://aanganerp.in/api/webhooks/interakt

# Local Swagger UI is enabled unless explicitly false. Production Compose sets false.
API_DOCS_ENABLED=true

# Automatic cancellation of abandoned checkouts and stock release.
PENDING_PAYMENT_TTL_MINUTES=30
ORDER_EXPIRY_SWEEP_SECONDS=60

# ── WhatsApp OTP (Interakt) ──────────────────────────────────────────────────
# disabled | interakt. Keep disabled until the approved Authentication template
# and an unexposed API key are available. Never commit the real key.
AUTH_OTP_PROVIDER=disabled
INTERAKT_API_KEY=
INTERAKT_API_BASE_URL=https://api.interakt.ai/v1/public
INTERAKT_OTP_TEMPLATE=elegant_sip_otp
INTERAKT_OTP_TEMPLATE_LANGUAGE=en
INTERAKT_WEBHOOK_SECRET=

# ── Two-step sign-in (staff) ─────────────────────────────────────────────────
# AES-256-GCM key for authenticator secrets, 64 hex chars: openssl rand -hex 32.
# Blank = staff cannot turn two-step sign-in on.
MFA_ENCRYPTION_KEY=

# ── Meta Conversions API ─────────────────────────────────────────────────────
# Blank = off. A real token here sends local test traffic to the live pixel, so
# set META_CAPI_TEST_EVENT_CODE (Events Manager → Test events) alongside it.
META_PIXEL_ID=1702510334659568
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
