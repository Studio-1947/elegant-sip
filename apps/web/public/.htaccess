# Elegant Sip — SPA fallback for the history router (Apache / XAMPP).
#
# Prerendered route shells (dist/shop/index.html, dist/product/<id>/index.html …)
# are served directly when they exist; anything else falls back to the root
# index.html so client-side routes still resolve.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve an existing prerendered directory shell.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]

  # Never rewrite real files or directories (assets, sitemap.xml, robots.txt).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Every real tea has a prerendered shell (matched above). Any other product
  # URL gets the app shell, which renders the not-found page, with a real 404
  # so search engines do not index a soft 404.
  RewriteRule ^product/[^/]+/?$ - [R=404,L]

  # Everything else boots the SPA.
  RewriteRule ^ /index.html [L]
</IfModule>

# The 404 body is the app shell, so the in-app not-found page still renders.
ErrorDocument 404 /index.html

# Long-cache fingerprinted assets; never cache the HTML shells.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|woff2|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
